---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="features" class="bg-[#0f0830] text-gray-300 py-12 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold">{t('features.title')}</h2>
      <p class="mt-2 text-base sm:text-lg text-gray-300">{t('features.subtitle')}</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
      <!-- Feature 1 -->
      <div class="flex items-start text-left p-4 bg-[#1B262C] rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <Icon name="general-english" class="w-6 h-6 sm:w-8 sm:h-8 mr-3 sm:mr-4 text-gray-300" aria-label="General English Icon" />
        <div>
          <h3 class="text-lg sm:text-xl font-bold mb-2">{t('features.general_english.title')}</h3>
          <p class="text-sm sm:text-base text-gray-300" set:html={t('features.general_english.content').replace(/(\d+%)/g, '<span class="text-[#fb6526]">$1</span>').replace(/\n/g, '<br>')}></p>
        </div>
      </div>
      <!-- Feature 2 -->
      <div class="flex items-start text-left p-4 bg-[#1B262C] rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <Icon name="english-for-it" class="w-6 h-6 sm:w-8 sm:h-8 mr-3 sm:mr-4 text-gray-300" aria-label="English for IT Icon" />
        <div>
          <h3 class="text-lg sm:text-xl font-bold mb-2">{t('features.english_for_it.title')}</h3>
          <p class="text-sm sm:text-base text-gray-300" set:html={t('features.english_for_it.content').replace(/(\d+%)/g, '<span class="text-[#fb6526]">$1</span>').replace(/\n/g, '<br>')}></p>
        </div>
      </div>
      <!-- Feature 3 -->
      <div class="flex items-start text-left p-4 bg-[#1B262C] rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <Icon name="telegram-community" class="w-6 h-6 sm:w-8 sm:h-8 mr-3 sm:mr-4 text-gray-300" aria-label="Telegram Community Icon" />
        <div>
          <h3 class="text-lg sm:text-xl font-bold mb-2">{t('features.telegram_community.title')}</h3>
          <p class="text-sm sm:text-base text-gray-300" set:html={t('features.telegram_community.content').replace(/\n/g, '<br>')}></p>
        </div>
      </div>
      <!-- Feature 4 -->
      <div class="flex items-start text-left p-4 bg-[#1B262C] rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <Icon name="job-interview" class="w-6 h-6 sm:w-8 sm:h-8 mr-3 sm:mr-4 text-gray-300" aria-label="Job Interview Icon" />
        <div>
          <h3 class="text-lg sm:text-xl font-bold mb-2">{t('features.job_interview.title')}</h3>
          <p class="text-sm sm:text-base text-gray-300" set:html={t('features.job_interview.content').replace(/(\d+%-\d+%|\d+%)/g, '<span class="text-[#fb6526]">$1</span>').replace(/\n/g, '<br>')}></p>
        </div>
      </div>
      <!-- Feature 5 -->
      <div class="flex items-start text-left p-4 bg-[#1B262C] rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <Icon name="cv-cover-letter" class="w-6 h-6 sm:w-8 sm:h-8 mr-3 sm:mr-4 text-gray-300" aria-label="CV and Cover Letter Icon" />
        <div>
          <h3 class="text-lg sm:text-xl font-bold mb-2">{t('features.cv_cover_letter.title')}</h3>
          <p class="text-sm sm:text-base text-gray-300" set:html={t('features.cv_cover_letter.content').replace(/(\d+%-\d+%|\d+%)/g, '<span class="text-[#fb6526]">$1</span>').replace(/\n/g, '<br>')}></p>
        </div>
      </div>
      <!-- Feature 6 -->
      <div class="flex items-start text-left p-4 bg-[#1B262C] rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
        <Icon name="ielts" class="w-6 h-6 sm:w-8 sm:h-8 mr-3 sm:mr-4 text-gray-300" aria-label="IELTS Icon" />
        <div>
          <h3 class="text-lg sm:text-xl font-bold mb-2">{t('features.ielts.title')}</h3>
          <p class="text-sm sm:text-base text-gray-300" set:html={t('features.ielts.content').replace(/(\d+%)/g, '<span class="text-[#fb6526]">$1</span>').replace(/\n/g, '<br>')}></p>
        </div>
      </div>
    </div>
  </div>
</section>
