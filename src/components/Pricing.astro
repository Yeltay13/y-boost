---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="pricing" class="bg-[#0f0830] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-extrabold text-gray-100">{t('pricing.title')}</h2>
      <p class="mt-2 text-lg text-gray-300">{t('pricing.subtitle')}</p>
    </div>

    <!-- Cards Grid -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">

      <!-- General English -->
      <div class="bg-[#1B262C] rounded-2xl shadow-lg p-6 flex flex-col h-full">
        <h3 class="text-2xl font-semibold text-gray-100">{t('pricing.general_english.title')}</h3>
        <p class="mt-2 text-3xl font-extrabold text-white">{t('pricing.general_english.price')} <span class="text-base font-medium text-gray-300">{t('pricing.general_english.period')}</span></p>
        <div class="mt-4 flex-1">
          <p class="font-medium text-gray-300">{t('pricing.general_english.lessons')}</p>
          <ul class="mt-2 space-y-1 text-gray-400">
            {t('pricing.general_english.features').map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
        <p class="mt-4 text-sm text-gray-400">{t('pricing.general_english.description')}</p>
        <a href="https://t.me/yelty" class="mt-6 w-full inline-block px-5 py-3 bg-purple-600 text-white rounded-lg font-semibold text-center shadow hover:bg-purple-500 transition">{t('pricing.cta')}</a>
      </div>

      <!-- English for IT Specialists -->
      <div class="bg-[#1B262C] rounded-2xl shadow-lg p-6 flex flex-col h-full">
        <h3 class="text-2xl font-semibold text-gray-100">{t('pricing.english_for_it.title')}</h3>
        <p class="mt-2 text-3xl font-extrabold text-white">{t('pricing.english_for_it.price')} <span class="text-base font-medium text-gray-300">{t('pricing.english_for_it.period')}</span></p>
        <div class="mt-4 flex-1">
          <p class="font-medium text-gray-300">{t('pricing.english_for_it.lessons')}</p>
          <ul class="mt-2 space-y-1 text-gray-400">
            {t('pricing.english_for_it.features').map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
        <p class="mt-4 text-sm text-gray-400">{t('pricing.english_for_it.description')}</p>
        <a href="https://t.me/yelty" class="mt-6 w-full inline-block px-5 py-3 bg-purple-600 text-white rounded-lg font-semibold text-center shadow hover:bg-purple-500 transition">{t('pricing.cta')}</a>
      </div>

      <!-- English for IT Teams -->
      <div class="bg-[#1B262C] rounded-2xl shadow-lg p-6 flex flex-col h-full">
        <h3 class="text-2xl font-semibold text-gray-100">{t('pricing.english_for_teams.title')}</h3>
        <p class="mt-2 text-3xl font-extrabold text-white">{t('pricing.english_for_teams.price')} <span class="text-base font-medium text-gray-300">{t('pricing.english_for_teams.period')}</span></p>
        <div class="mt-4 flex-1">
          <p class="font-medium text-gray-300">{t('pricing.english_for_teams.lessons')}</p>
