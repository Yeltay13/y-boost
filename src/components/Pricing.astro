      </div>

      <!-- Corporate -->
      <div class="bg-[#1B262C] rounded-2xl shadow-lg p-6 flex flex-col h-full">
        <h3 class="text-2xl font-semibold text-gray-100">{t('pricing.corporate.title')}</h3>
        <p class="mt-2 text-3xl font-extrabold text-white">{t('pricing.corporate.price')} <span class="text-base font-medium text-gray-300">{t('pricing.corporate.period')}</span></p>
        <div class="mt-4 flex-1">
          <p class="font-medium text-gray-300">{t('pricing.corporate.lessons')}</p>
          <ul class="mt-2 space-y-1 text-gray-400">
            {t('pricing.corporate.features').map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
        <p class="mt-4 text-sm text-gray-400">{t('pricing.corporate.description')}</p>
        <a href="https://t.me/yelty" class="mt-6 w-full inline-block px-5 py-3 bg-purple-600 text-white rounded-lg font-semibold text-center shadow hover:bg-purple-500 transition">{t('pricing.cta')}</a>
      </div>

    </div>
  </div>
</section>