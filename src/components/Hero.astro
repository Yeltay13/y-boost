---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t    = useTranslations(lang);

const heroUrl = '/assets/hero_copy.webp';
---

<section
  id="home"
  class="relative flex flex-col items-center justify-center min-h-screen bg-cover bg-center bg-no-repeat"
  style={`background-image: url('${heroUrl}');`}
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/60 z-0"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-3xl">
    <h1 class="text-5xl sm:text-6xl font-bold text-white leading-tight">
      {t("hero.title")}
    </h1>
    <p class="mt-4 text-lg text-gray-200 max-w-xl mx-auto">
      {t("hero.subtitle")}
    </p>

    <!-- CTA -->
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="https://t.me/yelty"
        class="px-6 py-3 bg-purple-600 text-white rounded-lg font-semibold hover:bg-purple-500 transition"
      >
        {t("hero.cta.primary")}
      </a>
      <a
        href="#features"
        class="px-6 py-3 border border-gray-300 text-gray-300 rounded-lg hover:bg-gray-700 transition"
      >
        {t("hero.cta.secondary")}
      </a>
    </div>

    <!-- Hidden iframe to capture the POST -->
    <iframe name="hidden_iframe" style="display:none;"></iframe>

    <!-- Lead form -->
    <form
      id="leadForm"
      action="https://script.google.com/macros/s/AKfycbzmRtkERe3uGDQK3P_ncONdEvWStYci3U4JBEIkomiyFXydWU5lCMBxKfhF9e3b_pgawA/exec"
      method="POST"
      target="hidden_iframe"
      class="mt-10 w-full max-w-md mx-auto space-y-4 bg-white/10 p-6 rounded-lg backdrop-blur-md"
    >
      <input
        name="name"
        type="text"
        placeholder={t("form.name")}
        required
        class="w-full px-4 py-2 rounded-md bg-white/90 text-black focus:outline-none"
      />
      <input
        name="email"
        type="email"
        placeholder={t("form.email")}
        required
        class="w-full px-4 py-2 rounded-md bg-white/90 text-black focus:outline-none"
      />
      <input
        name="telegram"
        type="text"
        placeholder={t("form.telegram")}
        class="w-full px-4 py-2 rounded-md bg-white/90 text-black focus:outline-none"
      />
      <input
        name="phone"
        type="tel"
        placeholder={t("form.phone")}
        class="w-full px-4 py-2 rounded-md bg-white/90 text-black focus:outline-none"
      />

      <!-- Honeypot -->
      <input name="nickname" type="text" class="hidden" autocomplete="off" />

      <button
        type="submit"
        class="w-full bg-purple-600 text-white py-2 rounded-md font-semibold hover:bg-purple-500 transition"
      >
        {t("form.submit")}
      </button>
    </form>

    <!-- Inline feedback -->
    <div id="formMessage" class="mt-4 text-center text-white"></div>
  </div>
</section>

<script type="module">
  const form      = document.getElementById("leadForm");
  const messageEl = document.getElementById("formMessage");
  const lang      = window.location.pathname.startsWith('/ru') ? 'ru' : 'en';

  const messages = {
    en: {
      sending: "Sending…",
      success: "✅ Thank you! We'll be in touch soon.",
      error:   "❌ Something went wrong. Please try again."
    },
    ru: {
      sending: "Отправка…",
      success: "✅ Спасибо! Мы свяжемся с вами скоро.",
      error:   "❌ Ошибка! Пожалуйста, попробуйте ещё раз."
    }
  };

  form.addEventListener("submit", () => {
    messageEl.textContent = messages[lang].sending;
    setTimeout(() => {
      messageEl.textContent = messages[lang].success;
      form.reset();
    }, 1000);
  });
</script>
