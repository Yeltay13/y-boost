---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const heroUrl = '/assets/hero_copy.webp';
---

<!-- src/components/Hero.astro -->
<section
  id="home"
  class="relative flex flex-col items-center justify-center min-h-screen bg-cover bg-center bg-no-repeat"
  style={`background-image: url('${heroUrl}');`}
>
  <!-- Gradient overlay for extra depth -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/60 z-0"></div>

  <!-- Content wrapper -->
  <div class="relative z-10 text-center px-6 max-w-3xl">
    <!-- Headline -->
    <h1 class="text-5xl sm:text-6xl font-bold text-white leading-tight">
      {t('hero.title')}
    </h1>
    <!-- Subhead -->
    <p class="mt-4 text-lg text-gray-200 max-w-xl mx-auto">
      {t('hero.subtitle')}
    </p>

    <!-- Call to action buttons -->
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="https://t.me/yelty"
        class="inline-block px-6 py-3 bg-purple-600 text-white rounded-lg font-semibold shadow hover:bg-purple-500 transition"
      >
        {t('hero.cta.primary')}
      </a>
      <a
        href="#features"
        class="inline-block px-6 py-3 border border-gray-300 text-gray-300 rounded-lg hover:bg-gray-700 transition"
      >
        {t('hero.cta.secondary')}
      </a>
    </div>
  </div>
</section>
