---
import { getLangFromUrl, useTranslations, languages } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav class="bg-[#0f0830] pt-4 pb-4 sticky top-0 z-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative flex h-16 items-center justify-between">
      <div class="flex items-center">
        <!-- Logo and Company Name as Link to Scroll to Top -->
        <a href={`/${lang}`} class="flex items-center">
          <img class="h-14 w-14 rounded-full" src="/assets/y_boost_logo_white.svg" alt="y-boost logo">
          <span class="ml-3 text-gray-300 text-xl font-semibold">Y-Boost</span>
        </a>
      </div>
      
      <!-- Mobile Menu Button -->
      <div class="absolute inset-y-0 right-0 flex items-center sm:hidden">
        <button id="mobile-menu-button" class="inline-flex items-center justify-center p-2 text-gray-300 hover:text-gray-100 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Navigation Links for Desktop -->
      <div class="hidden sm:flex space-x-4 ml-auto">
        <a href={`/${lang}`} class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.home')}</a>
        <a href="#features" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.features')}</a>
        <a href="#testimonials" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.testimonials')}</a>
        <a href="#pricing" class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.pricing')}</a>
        
        <!-- Language Switcher -->
        <div class="relative ml-4">
          <select id="language-selector" class="bg-transparent text-gray-300 text-sm border border-gray-600 rounded px-2 py-1 focus:outline-none focus:border-gray-400">
            {Object.entries(languages).map(([code, name]) => (
              <option value={code} selected={code === lang}>{name}</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="sm:hidden bg-[#0f0830] text-gray-300 hidden">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <a href={`/${lang}`} class="block rounded-md px-3 py-2 text-base font-medium hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.home')}</a>
      <a href="#features" class="block rounded-md px-3 py-2 text-base font-medium hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.features')}</a>
      <a href="#testimonials" class="block rounded-md px-3 py-2 text-base font-medium hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.testimonials')}</a>
      <a href="#pricing" class="block rounded-md px-3 py-2 text-base font-medium hover:bg-[#0F4C75] hover:text-gray-300 active:bg-[#3282B8]">{t('nav.pricing')}</a>
      
      <!-- Mobile Language Switcher -->
      <div class="px-3 py-2">
        <select id="mobile-language-selector" class="bg-transparent text-gray-300 text-base border border-gray-600 rounded px-2 py-1 w-full focus:outline-none focus:border-gray-400">
          {Object.entries(languages).map(([code, name]) => (
            <option value={code} selected={code === lang}>{name}</option>
          ))}
        </select>
      </div>
    </div>
  </div>
</nav>

<!-- Script to toggle mobile menu and enable smooth scroll -->
<script>
  document.getElementById('mobile-menu-button').addEventListener('click', function() {
    const mobileMenu = document.getElementById('mobile-menu');
    const expanded = mobileMenu.classList.toggle('hidden');
    this.setAttribute('aria-expanded', String(expanded));
  });

  // Language switcher functionality
  function handleLanguageChange(newLang) {
    const currentPath = window.location.pathname;
    const currentLang = currentPath.startsWith('/ru') ? 'ru' : 'en';
    
    if (newLang === currentLang) return;
    
    let newPath;
    if (newLang === 'en') {
      // Switch to English
      newPath = currentPath.replace('/ru', '/en');
    } else {
      // Switch to Russian
      newPath = currentPath.replace('/en', '/ru');
    }
    
    window.location.href = newPath;
  }

  // Desktop language switcher
  const desktopSelector = document.getElementById('language-selector') as HTMLSelectElement;
  if (desktopSelector) {
    desktopSelector.addEventListener('change', function() {
      handleLanguageChange(this.value);
    });
  }

  // Mobile language switcher
  const mobileSelector = document.getElementById('mobile-language-selector') as HTMLSelectElement;
  if (mobileSelector) {
    mobileSelector.addEventListener('change', function() {
      handleLanguageChange(this.value);
    });
  }

  // Enable smooth scroll and update URL
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const targetId = this.getAttribute('href').substring(1);
      const targetElement = document.getElementById(targetId) || document.body;

      // Smooth scroll to the section
      targetElement.scrollIntoView({
        behavior: 'smooth'
      });

      // Update the URL with the section ID (hash)
      if (targetId) {
        history.pushState(null, null, `#${targetId}`);
      } else {
        history.pushState(null, null, '#');
      }
    });
  });
</script>
