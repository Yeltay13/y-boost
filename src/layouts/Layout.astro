---
const { title }: { title: string } = Astro.props;
import "../styles/global.css";

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Astro description" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/assets/favicon.ico" sizes="any" />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{title}</title>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2SJSFNE6T1"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', 'G-2SJSFNE6T1');
  </script>
</head>
<body>
  <slot />
  <script type="module" src="/scripts/toggleContent.js"></script>
</body>
</html>
