---
const { title }: { title: string } = Astro.props;
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Y-Boost: English for IT pros" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://y-boost.com/" />
  <meta property="og:title" content="Y-Boost | Land Your International Dream Job" />
  <meta property="og:description" content="English for IT pros. Personalized coaching, mock-interviews, and real-world practice for IT professionals." />
  <meta property="og:image" content="https://y-boost.com/assets/final_logo.png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://y-boost.com/" />
  <meta name="twitter:title" content="Y-Boost | Land Your International Dream Job" />
  <meta name="twitter:description" content="English for IT pros. Personalized coaching, mock-interviews, and real-world practice for IT professionals." />
  <meta name="twitter:image" content="https://y-boost.com/assets/final_logo.png" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{title}</title>
</head>
<body class="min-h-screen bg-white">
  <slot />
  <script type="module" src="/scripts/toggleContent.js"></script>
</body>
</html>
